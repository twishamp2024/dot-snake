{
  "name": "dot-snake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A minimalist grid-based Snake game with keyboard and touch controls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
